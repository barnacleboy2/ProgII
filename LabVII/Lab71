def calcular_factorial(n):
    if n < 0:
        return "Error: no existe factorial de numeros negativos"
    factorial = 1
    for i in range(1, n + 1):
        factorial *= i
    return factorial

while True:
    entrada = input("Ingrese un numero entero positivo: ")
    try:
        n = int(entrada)
        if n < 0:
            print("Por favor ingrese un numero positivo.")
        else:
            break
    except:
        print("Entrada invalida, ingrese un numero entero.")

resultado = calcular_factorial(n)
print(f"\nEl factorial de {n} es: {resultado}")