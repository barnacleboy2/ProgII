import string

def contar_palabras_unicas(texto):
    texto_limpio = texto.lower()
    for signo in string.punctuation:
        texto_limpio = texto_limpio.replace(signo, "")
    palabras = texto_limpio.split()
    palabras_unicas = set(palabras)
    return len(palabras_unicas)

def palabra_mas_larga(texto):
    texto_limpio = texto.lower()
    for signo in string.punctuation:
        texto_limpio = texto_limpio.replace(signo, "")
    palabras = texto_limpio.split()
    if not palabras:
        return ""
    return max(palabras, key=len)

def frecuencia_caracteres(texto):
    texto_sin_espacios = texto.lower().replace(" ", "")
    texto_solo_letras = ""
    for c in texto_sin_espacios:
        if c.isalpha():
            texto_solo_letras += c
    total = len(texto_solo_letras)
    if total == 0:
        return {}
    frecuencia = {}
    for letra in texto_solo_letras:
        frecuencia[letra] = frecuencia.get(letra, 0) + 1
    resultado = {}
    for letra, cantidad in sorted(frecuencia.items()):
        porcentaje = (cantidad / total) * 100
        resultado[letra] = (cantidad, porcentaje)
    return resultado

