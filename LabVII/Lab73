texto = input("\nIngrese el texto a analizar:\n> ")

print("\n" + "=" * 50)
print("           REPORTE DE ANALISIS")
print("=" * 50)

unicas = contar_palabras_unicas(texto)
print(f"\n Palabras unicas encontradas : {unicas}")

larga = palabra_mas_larga(texto)
print(f" Palabra mas larga           : '{larga}' ({len(larga)} letras)")

print("\n Frecuencia de caracteres:")
print(f"   {'Letra':<8} {'Cantidad':<10} {'Porcentaje'}")
