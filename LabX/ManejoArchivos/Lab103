print("--- Añadiendo contenido ('a') ---")
with open("archivo_demo.txt", "a", encoding="utf-8") as f:
    f.write("\n¡Ahora el archivo tiene más contenido!")

# Leer el archivo después de agregar contenido
with open("archivo_demo.txt", "r", encoding="utf-8") as f:
    print(f.read())

print("\n--- Sobrescribiendo contenido ('w') ---")
with open("archivo_demo.txt", "w", encoding="utf-8") as f:
    f.write("Ups! ¡He borrado el contenido!")

# Leer el archivo después de sobrescribir
with open("archivo_demo.txt", "r", encoding="utf-8") as f:
    print(f.read())