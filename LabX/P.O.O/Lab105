class CalculadoraFactorial:
    def __init__(self, numero):
        self.numero = numero

    def calcular(self):
        if self.numero < 0:
            return "No definido para números negativos"
        factorial = 1
        for i in range(1, self.numero + 1):
            factorial *= i
        return factorial

# Bloque principal
if __name__ == "__main__":
    try:
        n = int(input("Introduzca un número entero para calcular su factorial: "))
        calc = CalculadoraFactorial(n)
        resultado = calc.calcular()
        print(f"El factorial de {n} es: {resultado}")
    except ValueError:
        print("Por favor, introduzca un número entero válido.")