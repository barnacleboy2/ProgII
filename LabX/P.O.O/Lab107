from abc import ABC, abstractmethod
import math

# Clase abstracta base
class FuncionMatematica(ABC):
    @abstractmethod
    def evaluar(self, x):
        pass

# Clase derivada: Funcion Lineal -> f(x) = mx + b
class FuncionLineal(FuncionMatematica):
    def __init__(self, m, b):
        self.m = m
        self.b = b

    def evaluar(self, x):
        return self.m * x + self.b

# Clase derivada: Funcion Cuadratica -> f(x) = ax^2 + bx + c
class FuncionCuadratica(FuncionMatematica):
    def __init__(self, a, b, c):
        self.a = a
        self.b = b
        self.c = c

    def evaluar(self, x):
        return self.a * (x ** 2) + self.b * x + self.c

# Clase derivada: Funcion Exponencial -> f(x) = a * e^(bx)
class FuncionExponencial(FuncionMatematica):
    def __init__(self, a, b):
        self.a = a
        self.b = b

    def evaluar(self, x):
        return self.a * math.exp(self.b * x)

# Demostración de Polimorfismo
if __name__ == "__main__":
    # Instanciamos las funciones con coeficientes arbitrarios de prueba
    funciones = [
        FuncionLineal(m=2, b=3),            # f(x) = 2x + 3
        FuncionCuadratica(a=1, b=-2, c=1),  # f(x) = x^2 - 2x + 1
        FuncionExponencial(a=2, b=0.5)      # f(x) = 2 * e^(0.5x)
    ]
    
    valor_x = 2.0
    print(f"--- Evaluando funciones matemáticas en x = {valor_x} ---")
    
    for funcion in funciones:
        resultado = funcion.evaluar(valor_x)
        print(f"Resultado en {type(funcion).__name__}: {resultado:.4f}")